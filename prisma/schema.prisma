generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Kişisel giriş linki (öğretmen / etüt mesulü). identity modülünündür; ad ve rol schedule'dan eşitlenir.
/// Link yenilenir ya da kaldırılırsa bu linkle açılmış oturumlar da geçersiz olur.
model AccessLink {
  id         String    @id @default(cuid())
  ownerId    String
  /// Teacher.id (schedule). Öğretmen başına tek link
  teacherId  String    @unique
  name       String
  /// TEACHER | MENTOR (Teacher.role ile aynı)
  role       String
  token      String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([ownerId])
}






/**
 * ============================ Kurum modülleri ============================
 */

model Classroom {
  id        String          @id @default(cuid())
  ownerId   String
  name      String
  level     String          @default("")
  createdAt DateTime        @default(now())
  students  Student[]
  homeworks Homework[]
  slots     ScheduleSlot[]
  sessions  LessonSession[]
  events    CalendarEvent[]
  plans     LessonPlan[]
  courses   Course[]
  members   ClassMember[]
  /// Sınıfın etüt mesulü (Teacher, role = MENTOR). Yazan: enrollment; öğretmen doğrulaması route'ta (schedule)
  mentorId  String?
  mentor    Teacher?        @relation("ClassMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  @@unique([ownerId, name])
}

/// Ek sınıf üyeliği: öğrencinin ana sınıfı (Student.classroomId) dışında üye olduğu sınıflar
model ClassMember {
  id          String    @id @default(cuid())
  ownerId     String
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([classroomId, studentId])
  @@index([studentId])
}

model Student {
  id             String           @id @default(cuid())
  ownerId        String
  classroomId    String?
  classroom      Classroom?       @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  studentNo      String
  firstName      String
  lastName       String
  phone          String           @default("")
  parentName     String           @default("")
  parentPhone    String           @default("")
  /// Kurum dışı öğrenci (STS: dışarıdan sınava katılan)
  external       Boolean          @default(false)
  /// Veli karnesi paylaşım anahtarı (giriş gerektirmeyen link). null = paylaşılmadı / iptal edildi
  parentToken    String?          @unique
  parentSharedAt DateTime?
  parentViewedAt DateTime?
  /// Veli karnesinde gösterilen öğretmen / rehberlik görüşü
  parentNote     String           @default("")
  createdAt      DateTime         @default(now())
  results        ExamResult[]
  homeworks      HomeworkStatus[]
  attendances    Attendance[]
  dispatches     ParentDispatch[]
  memberships    ClassMember[]
  scores         AssessmentScore[]

  @@unique([ownerId, studentNo])
}

model Exam {
  id        String       @id @default(cuid())
  ownerId   String
  name      String
  /// LGS | TYT | AYT | SERBEST
  type      String
  date      DateTime
  /// JSON: [{ name, count, keyA, keyB, topics?, levels?, bOrder? }] — key: "ABCD..." (her soru için bir harf);
  /// topics: A kitapçığı soru sırasıyla konu adları; bOrder[j] = B'deki j. sorunun A'daki indeksi
  sections  String
  /// Birden çok kitapçık var mı. false = tek kitapçık (A)
  bookletB  Boolean      @default(true)
  /// bookletB true iken kitapçık sayısı (2–4: A/B, A/B/C, A/B/C/D). Kullanım: domain > bookletCount()
  booklets  Int          @default(2)
  /// Kaç yanlış bir doğruyu götürür (0 = götürmez)
  wrongPer  Int          @default(4)
  /// Tahmini puan ayarı JSON: { base, coefs: number[] } (bölüm sırasıyla). Boş = türün varsayılanı
  scoring   String       @default("")
  /// Optik okuyucu (FMT) TXT biçimi JSON: { nameStart, nameLen, noStart, noLen, bookletStart, sectionStarts[] }. Boş = varsayılan
  readerFormat String    @default("")
  /// Optik formda öğrenci numarası alanı. false: alan basılmaz, okuturken öğrenci listeden seçilir (kişisel form her durumda şeritten okunur)
  omrStudentNo Boolean   @default(true)
  /// EXAM | WORKSHEET (çalışma kağıdı: puanlanmaz, yalnızca yazdırılır)
  purpose   String       @default("EXAM")
  /// Hocanın kendi sınavıysa bağlı ders (Course); kurum denemesinde boş
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  results   ExamResult[]
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  booklet   String   @default("A")
  /// Tüm sorular için cevap dizisi: harf, " " = boş, "*" = çift işaret
  answers   String
  /// JSON: [{ d, y, b, net }] bölüm sırasıyla
  stats     String
  totalNet  Float
  /// Tahmini puan (Exam.scoring ile)
  score     Float    @default(0)
  /// OMR | TXT | MANUAL
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
}

model Homework {
  id          String           @id @default(cuid())
  ownerId     String
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject     String
  title       String
  description String           @default("")
  assignedAt  DateTime         @default(now())
  dueDate     DateTime
  statuses    HomeworkStatus[]
}

model HomeworkStatus {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// PENDING | DONE | PARTIAL | NOT_DONE
  status     String   @default("PENDING")
  note       String   @default("")

  @@unique([homeworkId, studentId])
}

model Teacher {
  id       String          @id @default(cuid())
  ownerId  String
  name     String
  branch   String
  /// TEACHER (öğretmen) | MENTOR (etüt mesulü: yönetici yetkisi + öğretmen işleri)
  role     String          @default("TEACHER")
  slots    ScheduleSlot[]
  sessions LessonSession[]
  courses  Course[]
  mentorOf Classroom[]     @relation("ClassMentor")
}

/// Sınıfın dersi. Program satırları, değerlendirmeler ve (ad üzerinden) ödev / plan buna bağlanır
model Course {
  id          String         @id @default(cuid())
  ownerId     String
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  /// SCHOOL | VOCATIONAL | RELIGIOUS | PREP | STUDY (bkz. schedule > COURSE_KINDS)
  kind        String         @default("SCHOOL")
  /// Dersin sorumlusu: öğretmen ya da (dışarıda alınan derste) etüt mesulü
  teacherId   String?
  teacher     Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  /// Ders başka kurumda alınıyor; bilgilerini sorumlusu (genelde etüt mesulü) girer
  external    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  slots       ScheduleSlot[]
  assessments Assessment[]
  exams       Exam[]

  @@unique([classroomId, name])
  @@index([ownerId])
}

/// Haftalık ders programındaki tekrar eden ders
model ScheduleSlot {
  id          String          @id @default(cuid())
  ownerId     String
  classroomId String
  classroom   Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     String
  /// Sınıfın dersi; program satırı yalnızca var olan derse eklenir (ders Yönetim → Dersler'de açılır). Eski satırlar syncCourses ile bağlanır
  courseId    String?
  course      Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// GRUP | ETUT | OZEL
  lessonType  String          @default("GRUP")
  /// 1 = Pazartesi … 7 = Pazar
  dayOfWeek   Int
  startTime   String
  endTime     String
  sessions    LessonSession[]
}

/// Belirli bir tarihte işlenen ders (yoklama bu kayda bağlanır)
model LessonSession {
  id          String        @id @default(cuid())
  ownerId     String
  slotId      String?
  slot        ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  classroomId String
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     String
  lessonType  String        @default("GRUP")
  /// YYYY-MM-DD
  date        String
  startTime   String
  endTime     String
  attendances Attendance[]

  @@unique([slotId, date])
}

model Attendance {
  id        String        @id @default(cuid())
  sessionId String
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// PRESENT | ABSENT | LATE | EXCUSED
  status    String

  @@unique([sessionId, studentId])
}

/// Yıllık takvim etkinliği (planning modülü). classroomId boş = tüm kurum
model CalendarEvent {
  id          String     @id @default(cuid())
  ownerId     String
  title       String
  /// HOLIDAY | EXAM | MEETING | EVENT | OTHER
  kind        String     @default("EVENT")
  /// YYYY-MM-DD, iki uç dahil
  startDate   String
  endDate     String
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  note        String     @default("")
  /// Veli karnesinin "Yaklaşanlar" bölümünde gösterilsin mi (iç toplantılar gösterilmez)
  parentVisible Boolean  @default(false)
  createdAt   DateTime   @default(now())

  @@index([ownerId, startDate])
}

/// Sınıf + ders için yıllık ders planı (planning modülü). Yönetici girer.
model LessonPlan {
  id          String     @id @default(cuid())
  ownerId     String
  classroomId String
  classroom   Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject     String
  /// Eğitim yılı (2026 = 2026–2027)
  year        Int
  /// İlk haftanın herhangi bir günü (YYYY-MM-DD); dağıtım o haftanın Pazartesi'sinden başlar
  startDate   String
  /// Yöneticinin girdiği metin (satır başına konu; "| n" hafta, "+" aynı hafta)
  source      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       PlanItem[]

  @@unique([ownerId, classroomId, subject, year])
}

model PlanItem {
  id        String     @id @default(cuid())
  planId    String
  plan      LessonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     Int
  topic     String
  /// Plan metnindeki "# Ünite" başlığı; yoksa boş
  unit      String     @default("")
  /// Karşılık gelen müfredat konusu (aynı ders + sınıf düzeyi). Boş = müfredatta yok (elle yazılmış konu)
  curriculumTopicId String?
  curriculumTopic   CurriculumTopic? @relation(fields: [curriculumTopicId], references: [id], onDelete: SetNull)
  /// Başlangıç ve bitiş haftasının Pazartesi'si (YYYY-MM-DD)
  week      String
  endWeek   String
  /// İşlendiği tarih; null = işlenmedi
  doneDate  String?
  /// İşaretlendiği ders oturumu (yoklama ekranından işaretlendiyse)
  sessionId String?

  @@index([planId, order])
  @@index([curriculumTopicId])
}

/// Soru havuzu kaynağı: yüklenen PDF ya da resim(ler). Dosyalar storage/<ownerId>/ altında durur.
model QuestionSource {
  id        String         @id @default(cuid())
  ownerId   String
  name      String
  /// PDF | IMAGE
  kind      String
  /// Saklanan dosya anahtarları (JSON dizi). PDF'te tek dosya, resimlerde her dosya bir sayfa.
  files     String
  createdAt DateTime       @default(now())
  items     QuestionItem[]

  @@index([ownerId])
}

/// Havuzdaki tek soru: kaynaktan kesilmiş (görsel) ya da elle yazılmış / yapıştırılmış (content dolu, görsel isteğe bağlı).
model QuestionItem {
  id         String          @id @default(cuid())
  ownerId    String
  sourceId   String?
  source     QuestionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// Kaynaktaki sayfa (1 tabanlı) ve kesim kutusu (sayfaya göre 0–1 oranlı JSON {x,y,w,h})
  page       Int?
  crop       String          @default("")
  /// Bağlı müfredat satırı (CurriculumTopic.id): konu + kazanım. İlişki kurulmaz (curriculum modülünün tablosu);
  /// ders + düzey + konu adından kendiliğinden bağlanır (question-bank > linkOutcomes), satır silinirse boşalır
  curriculumTopicId String?
  /// Arşive kaldırılma zamanı: arşivdeki soru havuzda ve sınav kurarken görünmez, eski kitapçıklarda yerinde kalır
  archivedAt DateTime?
  /// Kesilmiş soruda sorunun görseli; yazılan soruda isteğe bağlı şekil/resim; boş = görsel yok
  imageKey   String          @default("")
  /// MC (çoktan seçmeli) | TF (doğru/yanlış) | OPEN (açık uçlu) | FILL (boşluk doldurma). Tanımlar: question-bank > QUESTION_TYPES
  type       String          @default("MC")
  /// Yazılan sorunun içeriği JSON: { stem, options? }. Boş = kesilmiş soru (içerik görseldedir)
  content    String          @default("")
  subject    String
  topic      String          @default("")
  /// Sınıf / sınav düzeyi: 5–12, LGS, TYT, AYT…
  grade      String          @default("")
  /// 1 kolay, 2 orta, 3 zor
  difficulty Int             @default(2)
  /// Bilişsel düzey: Bilgi | Kavrama | Uygulama | Analiz; boş = girilmemiş (shared/cognitive.ts)
  level      String          @default("")
  /// Doğru cevap; biçimi türe göre: MC "A"–"E", TF "D" | "Y", FILL boşlukların cevapları " | " ile, OPEN örnek cevap / puanlama notu. Boş = girilmemiş
  answer     String          @default("")
  /// Sorunun metni (ileride OCR / yapay zekâ ile doldurulur; aramada kullanılır)
  text       String          @default("")
  /// Çözüm / açıklama (isteğe bağlı, düz metin): kitapçıkta "Çözümler" sayfasına basılır; öğrenciye soruyla birlikte gösterilmez
  explanation String         @default("")
  /// Kaynak notu (isteğe bağlı): kitap / yayın / sayfa / yıl ya da "kendi sorumuz". Telif takibi ve arama için; kesilmiş soruda
  /// kaynak dosyanın adı ayrıca bilinir
  sourceNote String          @default("")
  /// Arama anahtarı: ders + konu + metin + kaynak notu, Türkçe küçük harf, şapkasız, ı = i (question-bank > searchKey). SQLite LIKE Türkçe harflerde
  /// büyük/küçük harf ayırdığı için arama bu alanda yapılır
  searchText String          @default("")
  /// Kutunun nasıl bulunduğu: MANUAL | AUTO (sezgisel) | AI
  origin     String          @default("MANUAL")
  /// Onay bekliyor: yapay zekâ (MCP) ile eklenen soru, öğretmen onaylayana kadar havuz listesinde ve sınav kurarken görünmez
  /// ("Onay bekleyen" süzgecinde listelenir)
  needsReview Boolean        @default(false)
  /// Yapay zekâ agent'ının notu: emin olmadığı noktalar (öğretmen onaylarken okur; onaydan sonra soru ayrıntısında kalır)
  agentNote  String          @default("")
  /// Yapay zekâ sorusunun nasıl yapıldığı: transcribed (kaynaktan olduğu gibi aktarıldı) | adapted (kaynaktan uyarlandı) |
  /// original (agent yazdı). Elle girilen soruda boş. Tanımlar: question-bank > BASIS
  basis      String          @default("")
  /// Cevabın kaynağı (yalnızca yapay zekâ sorusunda): key (kaynağın cevap anahtarından) | agent (agent çözdü). Elle girilende boş.
  /// Aktarılan soruda "agent" ise kaynakta anahtar yoktu; öğretmen cevabı onaylarken kontrol eder
  answerBy   String          @default("")
  createdAt  DateTime        @default(now())

  @@index([ownerId, subject])
}

/// Müfredat: ders + düzey için ünite / konu / kazanım listesi (kurum bir kez tanımlar).
/// Yıllık plan bu listeden kurulur; soru havuzu ve deneme konuları bu adlardan seçilir.
model CurriculumTopic {
  id      String @id @default(cuid())
  ownerId String
  subject String
  /// Sınıf / sınav düzeyi: 5–12, LGS, TYT, AYT
  grade   String
  unit    String @default("")
  topic   String
  /// Kazanım kodu (ör. M.8.1.1) ve açıklaması; isteğe bağlı
  code    String @default("")
  outcome String @default("")
  /// Önerilen ders haftası
  weeks   Int    @default(1)
  order   Int
  /// Bu konuya bağlı yıllık plan satırları (planning bağı kimlikle kurar; set kaydedilirken kimlikler korunur)
  planItems PlanItem[]

  @@index([ownerId, subject, grade])
}

/// Kurum ayarları (anahtar → JSON). Şimdilik reporting yazar: "score" = Başarı Skoru ağırlık ve eşikleri.
model Setting {
  ownerId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([ownerId, key])
}

/// Haftalık veli raporu: öğrenci + hafta başına tek kayıt (reporting yazar).
/// Haftanın öğretmen notu ve gönderim bilgisi. sentAt null = gönderilmedi.
model ParentDispatch {
  id        String    @id @default(cuid())
  ownerId   String
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Haftanın Pazartesi'si (YYYY-MM-DD)
  weekStart String
  note      String    @default("")
  /// WHATSAPP | COPY | PRINT (ileride SMS)
  channel   String    @default("")
  /// Gönderilen metin (kayıt için)
  message   String    @default("")
  sentAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([studentId, weekStart])
  @@index([ownerId, weekStart])
}

/// Puan cetveli (yönetici tanımlar). Değerlendirme açılınca kriterler değerlendirmeye kopyalanır.
model Rubric {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  /// Önerildiği ders türü (COURSE_KINDS) ya da boş = hepsi
  kind      String   @default("")
  /// JSON: [{ name, max }]
  criteria  String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

/// Sözlü / yazılı / uygulama değerlendirmesi: bir derste, bir tarihte
model Assessment {
  id         String            @id @default(cuid())
  ownerId    String
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Açan öğretmen ya da etüt mesulü (Teacher.id); kurum hesabı açtıysa boş
  teacherId  String?
  /// YYYY-MM-DD
  date       String
  title      String
  /// ORAL | WRITTEN | PRACTICE
  type       String
  rubricName String            @default("")
  /// JSON: [{ name, max }] — cetvelden kopya
  criteria   String
  maxTotal   Int
  /// Bağlı plan satırı (ör. ezber parçası); isteğe bağlı
  planItemId String?
  planTopic  String            @default("")
  createdAt  DateTime          @default(now())
  scores     AssessmentScore[]

  @@index([ownerId, date])
  @@index([courseId])
}

model AssessmentScore {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// JSON: number[] (kriter sırasıyla); gelmediyse []
  scores       String     @default("[]")
  total        Float?
  /// 0–100; gelmediyse null
  percent      Float?
  note         String     @default("")
  absent       Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
}
