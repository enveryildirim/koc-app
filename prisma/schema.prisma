generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  tests        Test[]
}

model Test {
  id               String     @id @default(cuid())
  ownerId          String
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  description      String     @default("")
  shareCode        String     @unique
  timeLimitMin     Int?
  passPercent      Int        @default(50)
  shuffleQuestions Boolean    @default(false)
  showAnswers      Boolean    @default(true)
  isPublished      Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  questions        Question[]
  attempts         Attempt[]
}

model Question {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order       Int
  /// SINGLE | MULTI | TRUE_FALSE | SHORT
  type        String
  text        String
  points      Int      @default(1)
  correctText String   @default("")
  explanation String   @default("")
  options     Option[]
  answers     Answer[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean  @default(false)
}

model Attempt {
  id              String    @id @default(cuid())
  testId          String
  test            Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  participantName String
  studentNo       String    @default("")
  /// ONLINE | OMR
  source          String    @default("ONLINE")
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  score           Int       @default(0)
  maxScore        Int       @default(0)
  answers         Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// JSON array of option ids
  optionIds  String   @default("[]")
  text       String   @default("")
  isCorrect  Boolean  @default(false)
  points     Int      @default(0)
}
